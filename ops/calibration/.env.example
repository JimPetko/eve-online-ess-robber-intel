# Copy to .env (setup.sh does this for you) and keep it mode 600.

# Fine-grained personal access token: https://github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories -> JimPetko/eve-online-ess-robber-intel
#   Repository permissions:
#     Contents:        Read and write  (clone, push the calibration branch, merge)
#     Pull requests:   Read and write  (open, label and merge the PR)
#     Metadata:        Read-only       (required by GitHub)
#     Checks:          Read-only       (read check runs on the PR head)
#     Commit statuses: Read-only       (read commit statuses on the PR head)
#   Nothing else. Set an expiry and renew it before it lapses.
GH_TOKEN=

# Author of the calibration commits.
GIT_AUTHOR_NAME=ESS calibration bot
GIT_AUTHOR_EMAIL=calibration@localhost

# Optional: track each month's calibration in Plane. Leave PLANE_API_KEY empty to skip.
PLANE_API_KEY=
PLANE_BASE_URL=http://192.168.0.187:8090
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_IDENTIFIER=ESS

# Optional: replace the default schedule (daily 15:00 UTC on days 5-28).
# CALIBRATION_CRON=0 15 5-28 * *
