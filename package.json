{
  "name": "ess-robber-intel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p src/server/tsconfig.build.json",
    "build:web": "vite build",
    "start": "node dist/server/main.js",
    "sync:universe": "node src/server/sync/universe-cli.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/domain && tsc -p src/server && tsc -p src/web",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
